{% extends 'base.html.twig' %}

{% block title %}Liste des Stagiaires{% endblock %}

{% block body %}

    {% if app.user %}
        <h1>Liste des stagiaires</h1>

        <a class="btn btn-primary mb-4" href="{{ path('trainee.new') }}">Ajouter un Stagiaire</a>
        <div class="d-flex flex-row flex-wrap justify-content-between gap-5">

            {% for trainee in trainees %}
                <div class="card" style="width: 18rem;">
                    <a href="{{ path('trainee.show', {id: trainee.id}) }}">
                        <img class="card-img-top" src="/uploads/images/{{ trainee.photo }}" alt="Card image">
                    </a>
                    <p class="text-center {{ trainee.absences|lenght > 5 ? "text-danger" : "" }}"><b>{{ trainee.lastname|upper }}</b> {{ trainee.name }}</p>
                </div>
            {% endfor %}
        </div>
    {% else %}
        <p class=" text-danger">Vous n'avez pas les permissions pour accéder à cette partie</p>
    {% endif %}
{% endblock %}

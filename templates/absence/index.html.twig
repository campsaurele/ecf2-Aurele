{% extends 'base.html.twig' %}

{% block title %}Liste des Absences{% endblock %}

{% block body %}
    <h1>Liste des Absences</h1>

    <a class="btn btn-primary mb-4" href="{{ path('absence.new') }}">Ajouter une Absence</a>
    <table class="table">
        <thead>
            <tr>
                <th>
                    Date
                </th>
                <th>
                    Stagiaire
                </th>
                <th>
                    Motif
                </th>
                <th>
                    Justificatif
                </th>

                <th>
                    Actions
                </th>
            </tr>
        </thead>
        <tbody>
            {% for absence in absences %}
                <tr>
                    <td>
                        {{ absence.dateTime|date('d/m/Y') }}
                    </td>
                    <td>
                        {{ absence.trainee.name }}
                    </td>
                    <td>
                        {{ absence.reason.name }}
                    </td>
                    <td>
                        {% if absence.document %}

                            <a href="/uploads/documents/{{ absence.document }}" target="_blank">{{ absence.document }}</a>
                        {% else %}
                            <p>Absence de Justificatif</p>
                        {% endif %}
                    </td>
                    <td>
                        <div class="d-flex gap-4">
                            <a class="btn btn-primary" href="{{ path('absence.edit', {id: absence.id}) }}">Edit</a>
                            <button type="button" class="btn btn-danger" data-bs-toggle="modal" data-bs-target="#deleteModal{{ absence.id }}">
                                Supprimer
                            </button>

                            <div class="modal fade" id="deleteModal{{ absence.id }}" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
                                <div class="modal-dialog">
                                    <div class="modal-content">
                                        <div class="modal-header">
                                            <h1 class="modal-title fs-5" id="exampleModalLabel">Voulez-vous vraiment supprimer l'absence de {{ absence.trainee.name }} du {{ absence.dateTime|date('d/m/Y') }}</h1>
                                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                        </div>
                                        <div class="modal-body">
                                            <p class=" text-danger">
                                                Attention: Cette action est irréversible
                                            </p>
                                        </div>
                                        <div class="modal-footer">
                                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                                            <form action="{{ path('absence.delete', {id: absence.id}) }}" method="POST">
                                                <input type="hidden" name="_method" value="DELETE"/>
                                                <button class="btn btn-danger" type="submit">Supprimer</button>
                                            </form>
                                        </div>
                                    </div>
                                </div>
                            </div>

                        </div>
                    </td>
                </tr>
            {% endfor %}
        </tbody>
    </table>
{% endblock %}

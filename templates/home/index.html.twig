{% extends 'base.html.twig' %}

{% block title %}Accueil AFPA{% endblock %}

{% block body %}
    <div class="example-wrapper">
        <h1>Bienvenue sur le logiciel de gestion des absences de l'AFPATATRA</h1>

        <p>Depuis cette page d'accueil, deux scénarios s'offrent à vous :</p>

        <div class="d-flex justify-content-evenly gap-4">
            <div class="card p-4 text-center" style="width: 18rem;">
                <p>Vous êtes un stagiaire ou un visiteur lambda.</p>
                <a class="btn btn-primary mt-auto" href="">Voir les statistiques</a>
            </div>

            <div class="card p-4 text-center" style="width: 18rem;">
                <p>Vous êtes formateur et souhaitez vous connecter avec vos identifiants.</p>
                <a class="btn btn-secondary mt-auto" href="{{ path('login') }}">
                    Se connecter
                </a>
            </div>
        </div>
    </div>

{% endblock %}
